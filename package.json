{
  "name": "pi-skill-manager",
  "version": "0.1.0",
  "description": "Prompt token audit, session-scoped skill/plugin manager, and project-based resource recommender for Pi",
  "author": "Cristiano Gariboldo <social@pixel3design.it> (https://github.com/pixel3design-hub)",
  "license": "GPL-2.0-only",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "skills",
    "tokens",
    "prompt"
  ],
  "files": [
    "extensions",
    "lib",
    "ui",
    "LICENSE",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./extensions/skill-manager.ts"
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "gpt-tokenizer": "^4.1.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^5.7.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pixel3design-hub/plugin_skill_manager.git"
  },
  "homepage": "https://github.com/pixel3design-hub/plugin_skill_manager#readme",
  "bugs": {
    "url": "https://github.com/pixel3design-hub/plugin_skill_manager/issues"
  }
}
